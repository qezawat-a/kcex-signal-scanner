# Telegram credentials (DO NOT commit real values — this file is gitignored)
# Fill these in, then run: python3 scanner.py --telegram-test
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Persistent storage (optional) ---
# Set to a Postgres connection string to persist config/state/agent-memory in a
# database instead of local JSON files. Without it the app falls back to files.
# Neon example (note the required sslmode):
# DATABASE_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# POSTGRES_URL and NEON_DATABASE_URL are also accepted.
DATABASE_URL=

# --- Agent LLM provider (pick one; first key found wins: openai > anthropic > google) ---
# Generic OpenAI-compatible (OpenAI / DeepSeek / Groq / OpenRouter / 9Router...):
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=auto
# Optional 2nd/3rd providers (fallback when the first fails):
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=
# 9Router shorthand (used only when AI_* are empty):
# NINEROUTER_URL=
# NINEROUTER_KEY=
